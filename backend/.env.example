# Copy this file to ".env" in the same folder and fill in your real values.
# Never commit your real .env file.

# Flask session secret — any random string
SECRET_KEY=change-this-to-a-random-string

# Where the frontend is served from (used for CORS + post-login redirect)
FRONTEND_ORIGIN=http://localhost:8000

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: "Web application"
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- AI providers ---
# Anthropic Claude — used to generate notes / outline / flashcards / quiz
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI — used for Whisper speech-to-text (audio + video transcription)
OPENAI_API_KEY=sk-your-key-here
