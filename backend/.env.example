# Copy this file to ".env" in the same folder and fill in your real values.
# Never commit your real .env file.

# Flask secret — any random string (sessions unused, kept for Flask)
SECRET_KEY=change-this-to-a-random-string

# Where the frontend is served from
FRONTEND_ORIGIN=http://127.0.0.1:5500

# --- AI provider (Groq) ---
# Get a free key at https://console.groq.com
# Used for both LLM generation and Whisper speech-to-text
GROQ_API_KEY=gsk-your-key-here
